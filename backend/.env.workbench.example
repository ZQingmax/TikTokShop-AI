# Workbench credentials reuse BAILIAN_API_KEY / DASHSCOPE_API_KEY and MIAOSHOU_APP_KEY / MIAOSHOU_APP_SECRET.
# Keep the key and both Bailian endpoints in the same region / workspace.
WORKBENCH_TEXT_MODEL=qwen3.5-plus
WORKBENCH_IMAGE_MODEL=qwen-image-3.0
# For an image-compatible workspace endpoint, set this independently of text calls:
# WORKBENCH_IMAGE_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
WORKBENCH_TRANSLATION_MODEL=qwen-mt-image-2.0
WORKBENCH_RESOLUTION=1024x1024
WORKBENCH_LANGUAGE=en
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WORKBENCH_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
WORKBENCH_ASSET_DIRECTORY=../.runtime/workbench-assets
WORKBENCH_TIMEOUT=180
# When a local proxy's Fake-IP DNS resolves every domain to 198.18.x.x, image downloads can only go
# through HTTPS_PROXY for exact trusted hosts. Add more exact hostnames here (comma separated, no wildcards):
WORKBENCH_TRUSTED_IMAGE_HOSTS=dashscope-a717.oss-accelerate.aliyuncs.com
