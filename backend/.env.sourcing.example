# Copy these values into backend/.env. Keys stay on the server; never commit .env.
BAILIAN_API_KEY=
# DASHSCOPE_API_KEY is also accepted if BAILIAN_API_KEY is empty.
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_VISION_MODEL=qwen3-vl-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
SOURCING_MODEL_TIMEOUT=90
SOURCING_WORKER_CONCURRENCY=2
SOURCING_MAX_ATTEMPTS=3
MIAOSHOU_APP_KEY=
MIAOSHOU_APP_SECRET=
MIAOSHOU_TIMEOUT=30
MIAOSHOU_REQUEST_INTERVAL=1.0
MIAOSHOU_POLL_INTERVAL=5
MIAOSHOU_MAX_POLLS=8
# 1688 CLI（只读货源）。无需 1688 开放平台密钥；登录态只保存在 CLI 自己的浏览器 Profile 中。
# local：后端直接调用本机 CLI（Windows 原生开发默认）；remote：后端在容器内，调用宿主机 CLI Adapter
ALIBABA1688_TRANSPORT=local
# 留空自动查找 1688 / 1688.cmd；也可指向 .../node_modules/1688-cli/dist/cli.js
ALIBABA1688_CLI_PATH=
ALIBABA1688_PROFILE=default
ALIBABA1688_SEARCH_TIMEOUT=90
ALIBABA1688_DETAIL_TIMEOUT=90
ALIBABA1688_MAX_RESULTS=20
ALIBABA1688_MIN_INTERVAL=1.5
ALIBABA1688_SEARCH_CACHE_TTL=600
# remote 模式：宿主机运行 python -m app.services.alibaba1688.adapter_server（令牌至少 24 字符）
ALIBABA1688_ADAPTER_URL=http://host.docker.internal:8765
ALIBABA1688_ADAPTER_TOKEN=
